{
  "name": "rackium",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "test:shared": "npm test --workspace @rackium/shared",
    "test:client": "npm test --workspace client",
    "test:server": "npm test --workspace @rackium/server",
    "clean:test-db": "npm run clean:test-db --workspace @rackium/server",
    "lint": "npm run lint --workspace client",
    "build": "npm run build --workspace client",
    "dev:local": "node server/dev/local.mjs",
    "dev:local:stop": "node server/dev/stop.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
