# Large or sensitive document types — never track these anywhere in the
# repo (reference renders/screenshots stay as tracked .png files; this
# only blocks PDFs and Excel workbooks like the Siemens survey template).
*.pdf
*.xlsx
*.xls

# Environment / secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Dependencies are installed once at the repo root (npm workspaces)
node_modules

# Real-mode Playwright harness runtime output (server/e2e/testServer.mjs)
server/e2e/.runtime-emails.json
# Local file storage (development) and the e2e server's file store
server/var/
server/e2e/.runtime-files/
client/dist-real/
