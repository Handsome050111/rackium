# /etc/rackium/rackium.env: the server's settings and secrets. setup-ubuntu.sh
# fills in everything marked @...@ and generates the secrets on the server; this
# file is never in the repo and is readable by root and the rackium user only.
# The server refuses to start while a value here is missing or a placeholder.
NODE_ENV=production
PORT=4000

# Local, replica set rs0, with its own user.
MONGODB_URI=mongodb://rackium:@MONGO_APP_PASSWORD@@127.0.0.1:27017/rackium?replicaSet=rs0&authSource=rackium

JWT_SECRET=@JWT_SECRET@

CLIENT_ORIGIN=https://@DOMAIN@
PUBLIC_APP_URL=https://@DOMAIN@
# Exactly one reverse proxy: Nginx.
TRUST_PROXY=1

# Fill this one in by hand, on the server (from your Resend account).
EMAIL_PROVIDER=resend
RESEND_API_KEY=__SET_ME__
EMAIL_FROM=Rackium <no-reply@@DOMAIN@>

LOG_LEVEL=info
FILE_STORAGE_DIR=/var/lib/rackium/files
CHROMIUM_PATH=/usr/bin/google-chrome-stable
DOCUMENTS_AUTO_PROCESS=true

# Testers are invited (server/scripts/invite-testers.mjs): no public sign-up.
SIGNUP_ENABLED=false
# Shown on every screen. Empty: no banner.
ENV_BANNER=Test environment — do not enter real customer data
