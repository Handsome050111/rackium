# Copy to server/.env and fill in. The server refuses to start in production if
# a required value is missing or still a placeholder.
NODE_ENV=development
PORT=4000

# MongoDB must be a replica set (transactions). Atlas: each developer uses a
# free cluster and pastes its connection string here. See docs/BACKEND-SETUP.md.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/rackium?retryWrites=true&w=majority
MONGODB_DB=rackium

# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# 0 = use the socket address (direct access). 1 = one reverse proxy in front (Nginx on the VPS).
TRUST_PROXY=0

# console: writes emails to the log (development). resend: sends real mail.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Rackium <no-reply@localhost>

LOG_LEVEL=info
